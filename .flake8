[flake8]
# One config for pre-commit, CI and local runs.
# Ignored: black's own choices (E203, E231, W503), long lines black leaves
# (E501), and findings in older code kept as they were in CI.
max-line-length = 100
extend-ignore = E203,E231,W503,E501,E302,E402,E722,E731,F401,F541,F811,F821,F841
exclude = .git,__pycache__,.venv,venv,build,dist
